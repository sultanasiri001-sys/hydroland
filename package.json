{
  "name": "hydroland",
  "version": "0.1.0",
  "private": true,
  "description": "HYDROLAND — Intelligent Diving, Marine Activities & Tourism Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "multer": "^2.3.0",
    "node-forge": "git+https://github.com/Krysthyan/forge.git#ceba34402e329f0365134f23fe19898756527d65"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.8"
}
