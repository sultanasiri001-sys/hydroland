# PostgreSQL connection for local development only. Never commit production credentials.
DATABASE_URL="postgresql://hydroland:hydroland@localhost:5432/hydroland?schema=public"
PORT=3001

# Provider lifecycle is fail-closed by default. Set only after the matching
# Sandbox credential and callback verification have passed.
# Allowed values: NOT_SELECTED, SANDBOX, CONFIGURED, VERIFIED, PRODUCTION_ENABLED, DEGRADED, DISABLED
HYDROLAND_INTEGRATION_PAYMENT_PSP_STATUS=SANDBOX
HYDROLAND_INTEGRATION_EMAIL_STATUS=NOT_SELECTED
HYDROLAND_INTEGRATION_SMS_STATUS=SANDBOX
HYDROLAND_INTEGRATION_WEATHER_MARINE_STATUS=SANDBOX
HYDROLAND_INTEGRATION_OBJECT_STORAGE_STATUS=NOT_SELECTED
STORMGLASS_API_KEY=replace-with-sandbox-key

# Account email delivery. Keep disabled until a verified sender and real key
# have been configured securely. SANDBOX still calls the configured provider.
HYDROLAND_EMAIL_PROVIDER=RESEND
RESEND_API_KEY=
HYDROLAND_EMAIL_FROM=
HYDROLAND_PUBLIC_WEB_ORIGIN=http://localhost:4173

# Optional Google Identity Services web client; leave blank to hide Google login.
# Authorized JavaScript origins must match the deployed web origin.
GOOGLE_CLIENT_ID=

# Private account documents. Independent from CLOUDFLARE_R2_* offline delivery.
# Keep blank/false until a real bucket, scoped credentials and protections are verified.
# Production requires HTTPS plus all three confirmations, even in SANDBOX lifecycle.
HYDROLAND_OBJECT_STORAGE_ENDPOINT=
HYDROLAND_OBJECT_STORAGE_BUCKET=
HYDROLAND_OBJECT_STORAGE_REGION=us-east-1
HYDROLAND_OBJECT_STORAGE_ACCESS_KEY_ID=
HYDROLAND_OBJECT_STORAGE_SECRET_ACCESS_KEY=
HYDROLAND_OBJECT_STORAGE_PRIVATE_ACCESS_CONFIRMED=false
HYDROLAND_OBJECT_STORAGE_ENCRYPTION_CONFIRMED=false
HYDROLAND_OBJECT_STORAGE_VERSIONING_CONFIRMED=false
