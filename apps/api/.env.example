# PostgreSQL connection for local development only. Never commit production credentials.
DATABASE_URL="postgresql://hydroland:hydroland@localhost:5432/hydroland?schema=public"
PORT=3001

# Provider lifecycle is fail-closed by default. Set only after the matching
# Sandbox credential and callback verification have passed.
# Allowed values: SANDBOX, CONFIGURED, VERIFIED, PRODUCTION_ENABLED, DEGRADED, DISABLED
HYDROLAND_INTEGRATION_PAYMENT_PSP_STATUS=SANDBOX
HYDROLAND_INTEGRATION_EMAIL_STATUS=SANDBOX
HYDROLAND_INTEGRATION_SMS_STATUS=SANDBOX
HYDROLAND_INTEGRATION_WEATHER_MARINE_STATUS=SANDBOX
HYDROLAND_INTEGRATION_OBJECT_STORAGE_STATUS=SANDBOX
STORMGLASS_API_KEY=replace-with-sandbox-key
