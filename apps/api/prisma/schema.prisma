generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PersonStatus {
  PENDING
  ACTIVE
  SUSPENDED
  RESTRICTED
  ARCHIVED
}

enum AccountStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  ARCHIVED
}

enum RoleScope {
  OWN
  ORGANIZATION
  TRIP
  REGION
  PLATFORM
}

enum ProfessionalRoleRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum CredentialVerificationStatus {
  UNVERIFIED
  PENDING
  DOCUMENT_VERIFIED
  VERIFIED
  REJECTED
  EXPIRED
}

enum DocumentScanStatus {
  PENDING
  CLEAN
  REJECTED
}

enum DocumentUploadIntentStatus {
  CREATED
  UPLOADED
  SCANNING
  CLEAN
  REJECTED
  EXPIRED
  CONSUMED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Person {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  firstName String
  middleName String?
  lastName String
  nationalityCode String? @db.VarChar(3)
  preferredLanguage String @default("ar") @db.VarChar(5)
  status PersonStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  accounts Account[]
  profile Profile?
  personRoles PersonRole[]
  professionalRoleRequests ProfessionalRoleRequest[] @relation("ProfessionalRoleApplicant")
  reviewedProfessionalRoleRequests ProfessionalRoleRequest[] @relation("ProfessionalRoleReviewer")
  credentials ProfessionalCredential[] @relation("CredentialOwner")
  verifiedCredentials ProfessionalCredential[] @relation("CredentialVerifier")
  documents DocumentRecord[]
  documentUploadIntents DocumentUploadIntent[]
  notifications Notification[]
  auditEvents AuditEvent[]
  @@index([status])
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid
  email String? @unique
  phoneE164 String? @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status AccountStatus @default(PENDING)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions Session[]
  @@index([personId])
  @@index([status])
}

model Profile {
  id String @id @default(uuid()) @db.Uuid
  personId String @unique @db.Uuid
  displayName String?
  bio String?
  avatarFileId String?
  regionCode String?
  city String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  nameAr String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  permissions RolePermission[]
  personRoles PersonRole[]
  professionalRoleRequests ProfessionalRoleRequest[]
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  key String @unique
  nameAr String
  description String?
  createdAt DateTime @default(now())
  roles RolePermission[]
}

model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  @@id([roleId, permissionId])
}

model PersonRole {
  id String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid
  roleId String @db.Uuid
  scope RoleScope @default(OWN)
  scopeRef String?
  activeFrom DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@index([personId, roleId])
  @@index([scope, scopeRef])
}

model ProfessionalRoleRequest {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  personId String @db.Uuid
  roleId String @db.Uuid
  status ProfessionalRoleRequestStatus @default(DRAFT)
  applicantNote String?
  reviewerNote String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewerPersonId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  person Person @relation("ProfessionalRoleApplicant", fields: [personId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  reviewer Person? @relation("ProfessionalRoleReviewer", fields: [reviewerPersonId], references: [id], onDelete: Restrict)
  credentials ProfessionalCredential[]
  documents DocumentRecord[]
  documentUploadIntents DocumentUploadIntent[]
  @@index([personId, status])
  @@index([roleId, status])
  @@index([reviewerPersonId])
}

model ProfessionalCredential {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  personId String @db.Uuid
  roleRequestId String? @db.Uuid
  credentialType String
  title String
  issuerName String
  credentialNumber String?
  issuedAt DateTime?
  expiresAt DateTime?
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)
  verificationSource String?
  verifiedAt DateTime?
  verifiedByPersonId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  person Person @relation("CredentialOwner", fields: [personId], references: [id], onDelete: Restrict)
  roleRequest ProfessionalRoleRequest? @relation(fields: [roleRequestId], references: [id], onDelete: Restrict)
  verifiedBy Person? @relation("CredentialVerifier", fields: [verifiedByPersonId], references: [id], onDelete: Restrict)
  documents DocumentRecord[]
  documentUploadIntents DocumentUploadIntent[]
  @@index([personId, verificationStatus])
  @@index([roleRequestId])
  @@index([expiresAt])
}

model DocumentUploadIntent {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  personId String @db.Uuid
  credentialId String? @db.Uuid
  roleRequestId String? @db.Uuid
  documentType String
  originalFileName String
  declaredMimeType String
  declaredByteSize Int
  storageObjectKey String @unique
  status DocumentUploadIntentStatus @default(CREATED)
  expiresAt DateTime
  uploadedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  credential ProfessionalCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  roleRequest ProfessionalRoleRequest? @relation(fields: [roleRequestId], references: [id], onDelete: Restrict)
  @@index([personId, status, expiresAt])
  @@index([credentialId])
  @@index([roleRequestId])
}

model DocumentRecord {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  personId String @db.Uuid
  credentialId String? @db.Uuid
  roleRequestId String? @db.Uuid
  documentType String
  originalFileName String
  mimeType String
  byteSize Int
  sha256Hex String @db.VarChar(64)
  storageObjectKey String @unique
  scanStatus DocumentScanStatus @default(PENDING)
  scanDetail String?
  scannedAt DateTime?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  credential ProfessionalCredential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  roleRequest ProfessionalRoleRequest? @relation(fields: [roleRequestId], references: [id], onDelete: Restrict)
  @@index([personId, createdAt])
  @@index([credentialId])
  @@index([roleRequestId])
  @@index([scanStatus])
  @@index([sha256Hex])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(cuid())
  personId String @db.Uuid
  type String
  titleAr String
  bodyAr String
  status NotificationStatus @default(UNREAD)
  referenceType String?
  referenceId String?
  createdAt DateTime @default(now())
  readAt DateTime?
  archivedAt DateTime?
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  @@index([personId, status, createdAt])
  @@index([referenceType, referenceId])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorPersonId String? @db.Uuid
  action String
  entityType String
  entityId String
  result String
  reason String?
  referenceId String?
  context Json?
  createdAt DateTime @default(now())
  actor Person? @relation(fields: [actorPersonId], references: [id], onDelete: Restrict)
  @@index([actorPersonId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  refreshTokenHash String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId])
  @@index([expiresAt])
}
