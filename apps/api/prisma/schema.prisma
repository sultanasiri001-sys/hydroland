generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProfessionalRole {
  DIVER
  INSTRUCTOR
  DIVE_CENTER
  BOAT_OWNER
  STAFF
  ORGANIZATION
  ADMIN
  REVIEWER
}

enum RoleAssignmentStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum CredentialVerificationStatus {
  UNVERIFIED
  PENDING
  DOCUMENT_VERIFIED
  VERIFIED
  REJECTED
  EXPIRED
}

enum ActivationRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  QUARANTINED
  AVAILABLE
  REJECTED
  ARCHIVED
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
}

model Person {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  phone     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account         Account?
  professional    ProfessionalProfile?
  credentials     Credential[]
  auditEvents     AuditEvent[] @relation("ActorAuditEvents")
}

model Account {
  id             String        @id @default(uuid())
  personId       String        @unique
  email          String        @unique
  passwordHash   String
  status         AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  person           Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  sessions         Session[]
  roleAssignments  RoleAssignment[]
  activationRequests ActivationRequest[] @relation("ApplicantRequests")
  reviewDecisions  ReviewDecision[]      @relation("ReviewerDecisions")
  notifications    Notification[]
  bookings         Booking[]
}

model Session {
  id        String   @id @default(uuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
}

model ProfessionalProfile {
  id          String   @id @default(uuid())
  personId    String   @unique
  headline    String?
  bio         String?
  regionCode  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
}

model RoleAssignment {
  id        String               @id @default(uuid())
  accountId String
  role      ProfessionalRole
  status    RoleAssignmentStatus @default(DRAFT)
  scope     Json?
  activeAt  DateTime?
  endedAt   DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  account            Account             @relation(fields: [accountId], references: [id], onDelete: Restrict)
  activationRequests ActivationRequest[]

  @@unique([accountId, role])
  @@index([role, status])
}

model Credential {
  id                 String                     @id @default(uuid())
  personId           String
  issuer             String
  title              String
  credentialNumber   String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  verificationStatus CredentialVerificationStatus @default(UNVERIFIED)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  person    Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
  documents Document[]

  @@index([personId, verificationStatus])
}

model Document {
  id           String         @id @default(uuid())
  credentialId String?
  ownerId      String
  storageKey   String         @unique
  originalName String
  mimeType     String
  byteSize     Int
  sha256       String         @unique
  status       DocumentStatus @default(UPLOADED)
  createdAt    DateTime       @default(now())
  archivedAt   DateTime?

  credential Credential? @relation(fields: [credentialId], references: [id], onDelete: Restrict)

  @@index([ownerId, status])
}

model ActivationRequest {
  id               String                  @id @default(uuid())
  applicantId      String
  roleAssignmentId String
  status           ActivationRequestStatus @default(DRAFT)
  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  applicant      Account        @relation("ApplicantRequests", fields: [applicantId], references: [id], onDelete: Restrict)
  roleAssignment RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict)
  decisions      ReviewDecision[]

  @@index([status, createdAt])
}

model ReviewDecision {
  id                  String   @id @default(uuid())
  activationRequestId String
  reviewerId          String
  outcome             String
  reason              String?
  createdAt           DateTime @default(now())

  activationRequest ActivationRequest @relation(fields: [activationRequestId], references: [id], onDelete: Restrict)
  reviewer          Account           @relation("ReviewerDecisions", fields: [reviewerId], references: [id], onDelete: Restrict)
}

model Notification {
  id        String             @id @default(uuid())
  accountId String
  type      String
  payload   Json
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id          String   @id @default(uuid())
  actorId     String?
  action      String
  resource    String
  resourceId  String?
  requestId   String?
  ipAddress   String?
  metadata    Json?
  occurredAt  DateTime @default(now())

  actor Person? @relation("ActorAuditEvents", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([resource, resourceId, occurredAt])
  @@index([actorId, occurredAt])
}


enum TripStatus { DRAFT OPEN CLOSED CANCELLED COMPLETED }
enum BookingStatus { PENDING CONFIRMED CANCELLED }

model Trip {
  id String @id @default(uuid())
  title String
  type String
  startsAt DateTime
  endsAt DateTime
  capacity Int
  status TripStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings Booking[]
  @@index([status, startsAt])
}
model Booking {
  id String @id @default(uuid())
  tripId String
  accountId String
  status BookingStatus @default(PENDING)
  seats Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trip Trip @relation(fields:[tripId],references:[id],onDelete:Restrict)
  account Account @relation(fields:[accountId],references:[id],onDelete:Restrict)
  @@unique([tripId,accountId])
  @@index([tripId,status])
}
