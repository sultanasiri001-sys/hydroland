  checkedByAccountId String?
  marineAsset MarineAsset @relation(fields:[marineAssetId],references:[id],onDelete:Restrict)
  @@index([marineAssetId,checkedAt])
  @@index([tripId,status])
}


enum ManagedDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SIGNED
  ARCHIVED
}

enum DocumentTemplateStatus {
  ACTIVE
  INACTIVE
}

model DocumentTemplate {
  id String @id @default(uuid())
  organizationId String
  code String
  titleAr String
  titleEn String
  department String
  version Int @default(1)
  status DocumentTemplateStatus @default(ACTIVE)
  printable Boolean @default(true)
  fields Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  documents ManagedDocument[]
  @@unique([organizationId,code,version])
  @@index([organizationId,department,status])
}

model ManagedDocument {
  id String @id @default(uuid())
  organizationId String
  templateId String
  referenceNumber String
  department String
  status ManagedDocumentStatus @default(DRAFT)
  version Int @default(1)
  contentHash String
  documentBrandVersion Int?
  payload Json
  createdByAccountId String
  approvedByAccountId String?
  signedByAccountId String?
  archivedByAccountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  approvedAt DateTime?
  signedAt DateTime?
  archivedAt DateTime?
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  template DocumentTemplate @relation(fields:[templateId], references:[id], onDelete:Restrict)
  createdBy Account @relation("ManagedDocumentCreator", fields:[createdByAccountId], references:[id], onDelete:Restrict)
  approvedBy Account? @relation("ManagedDocumentApprover", fields:[approvedByAccountId], references:[id], onDelete:Restrict)
  signedBy Account? @relation("ManagedDocumentSigner", fields:[signedByAccountId], references:[id], onDelete:Restrict)
  archivedBy Account? @relation("ManagedDocumentArchiver", fields:[archivedByAccountId], references:[id], onDelete:Restrict)
  lifecycleEvents DocumentLifecycleEvent[]
  revisions DocumentRevision[]
  @@unique([organizationId,referenceNumber])
  @@index([organizationId,department,status])
  @@index([templateId,status])
}

model DocumentRevision {
  id String @id @default(uuid())
  documentId String
  version Int
  contentHash String
  payload Json
  createdByAccountId String
  createdAt DateTime @default(now())
  document ManagedDocument @relation(fields:[documentId], references:[id], onDelete:Restrict)
  createdBy Account @relation("DocumentRevisionCreator", fields:[createdByAccountId], references:[id], onDelete:Restrict)
  @@unique([documentId,version])
  @@index([documentId,createdAt])
  @@index([createdByAccountId,createdAt])
}

model DocumentLifecycleEvent {
  id String @id @default(uuid())
  documentId String
  actorAccountId String
  action String
  fromStatus ManagedDocumentStatus?
  toStatus ManagedDocumentStatus
  version Int
  metadata Json?
  occurredAt DateTime @default(now())
  document ManagedDocument @relation(fields:[documentId], references:[id], onDelete:Restrict)
  actor Account @relation("DocumentLifecycleActor", fields:[actorAccountId], references:[id], onDelete:Restrict)
  @@index([documentId,occurredAt])
  @@index([actorAccountId,occurredAt])
}

model DocumentReferenceCounter {
  id String @id @default(uuid())
  organizationId String
  department String
  year Int
  lastNumber Int @default(0)
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  @@unique([organizationId,department,year])
  @@index([organizationId,year])
}
