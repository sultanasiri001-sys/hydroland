// Canonical HR Prisma fragment.
// Merge into schema.prisma only after relation reconciliation against existing Account/Organization/Document models.

enum OrgUnitType { HQ REGION CENTER DEPARTMENT UNIT TEAM }
enum EmploymentStatus { DRAFT PENDING_APPROVAL ACTIVE ON_LEAVE SUSPENDED TERMINATED OFFBOARDED }
enum WorkerClass { EMPLOYEE TEMPORARY_WORKER INDEPENDENT_PROFESSIONAL CONTRACTOR CENTER_AFFILIATED TRIP_ONLY }
enum EmploymentMovementType { APPOINTMENT TRANSFER TEMPORARY_ASSIGNMENT PROMOTION DEMOTION SUSPENSION RETURN_TO_ROLE TERMINATION }
enum HrRequestStatus { DRAFT SUBMITTED HR_REVIEW APPROVAL_REQUIRED APPROVED REJECTED CANCELLED EFFECTIVE CLOSED }

model OrgUnit {
  id String @id @default(uuid())
  organizationId String
  parentId String?
  type OrgUnitType
  code String
  nameAr String
  nameEn String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent OrgUnit? @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrgUnit[] @relation("OrgUnitTree")
  positions Position[]
  employments Employment[]
  movementsFrom EmploymentMovement[] @relation("MovementFromOrgUnit")
  movementsTo EmploymentMovement[] @relation("MovementToOrgUnit")
  @@unique([organizationId, code])
  @@index([organizationId, parentId, type])
}

model Position {
  id String @id @default(uuid())
  orgUnitId String
  code String
  titleAr String
  titleEn String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  employments Employment[]
  movementsFrom EmploymentMovement[] @relation("MovementFromPosition")
  movementsTo EmploymentMovement[] @relation("MovementToPosition")
  @@unique([orgUnitId, code])
}

model Employment {
  id String @id @default(uuid())
  accountId String
  organizationId String
  orgUnitId String
  positionId String?
  managerEmploymentId String?
  workerClass WorkerClass
  status EmploymentStatus @default(DRAFT)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  position Position? @relation(fields: [positionId], references: [id], onDelete: Restrict)
  manager Employment? @relation("EmploymentManager", fields: [managerEmploymentId], references: [id], onDelete: Restrict)
  reports Employment[] @relation("EmploymentManager")
  contracts EmploymentContract[]
  movements EmploymentMovement[]
  leaveRequests LeaveRequest[]
  attendanceEntries AttendanceEntry[]
  performanceCycles PerformanceCycle[]
  relationsCases EmployeeRelationsCase[]
  offboardingCases OffboardingCase[]
  @@index([accountId, status])
  @@index([organizationId, orgUnitId, status])
}

model EmploymentContract {
  id String @id @default(uuid())
  employmentId String
  version Int @default(1)
  contractType String
  effectiveFrom DateTime
  effectiveTo DateTime?
  documentId String?
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  @@unique([employmentId, version])
}

model EmploymentMovement {
  id String @id @default(uuid())
  employmentId String
  type EmploymentMovementType
  status HrRequestStatus @default(DRAFT)
  fromOrgUnitId String?
  toOrgUnitId String?
  fromPositionId String?
  toPositionId String?
  requestedByAccountId String
  reviewedByAccountId String?
  approvedByAccountId String?
  effectiveAt DateTime?
  reason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  fromOrgUnit OrgUnit? @relation("MovementFromOrgUnit", fields: [fromOrgUnitId], references: [id], onDelete: Restrict)
  toOrgUnit OrgUnit? @relation("MovementToOrgUnit", fields: [toOrgUnitId], references: [id], onDelete: Restrict)
  fromPosition Position? @relation("MovementFromPosition", fields: [fromPositionId], references: [id], onDelete: Restrict)
  toPosition Position? @relation("MovementToPosition", fields: [toPositionId], references: [id], onDelete: Restrict)
  requestedBy Account @relation("EmploymentMovementRequestedBy", fields: [requestedByAccountId], references: [id], onDelete: Restrict)
  reviewedBy Account? @relation("EmploymentMovementReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  approvedBy Account? @relation("EmploymentMovementApprovedBy", fields: [approvedByAccountId], references: [id], onDelete: Restrict)
  @@index([employmentId, status])
}

model LeaveRequest {
  id String @id @default(uuid())
  employmentId String
  type String
  status HrRequestStatus @default(DRAFT)
  startsAt DateTime
  endsAt DateTime
  requestedByAccountId String
  approvedByAccountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  requestedBy Account @relation("LeaveRequestedBy", fields: [requestedByAccountId], references: [id], onDelete: Restrict)
  approvedBy Account? @relation("LeaveApprovedBy", fields: [approvedByAccountId], references: [id], onDelete: Restrict)
}

model AttendanceEntry {
  id String @id @default(uuid())
  employmentId String
  workDate DateTime @db.Date
  clockInAt DateTime?
  clockOutAt DateTime?
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  @@unique([employmentId, workDate])
}

model PerformanceCycle {
  id String @id @default(uuid())
  employmentId String
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  status String @default("DRAFT")
  goals Json?
  managerAssessment Json?
  hrReview Json?
  developmentPlan Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
}

model EmployeeRelationsCase {
  id String @id @default(uuid())
  employmentId String
  caseType String
  status HrRequestStatus @default(DRAFT)
  openedByAccountId String
  reviewedByAccountId String?
  approvedByAccountId String?
  summary String?
  decision String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  openedBy Account @relation("EmployeeRelationsOpenedBy", fields: [openedByAccountId], references: [id], onDelete: Restrict)
  reviewedBy Account? @relation("EmployeeRelationsReviewedBy", fields: [reviewedByAccountId], references: [id], onDelete: Restrict)
  approvedBy Account? @relation("EmployeeRelationsApprovedBy", fields: [approvedByAccountId], references: [id], onDelete: Restrict)
}

model OffboardingCase {
  id String @id @default(uuid())
  employmentId String
  status HrRequestStatus @default(DRAFT)
  reason String?
  lastWorkingAt DateTime?
  clearance Json?
  iamRevokedAt DateTime?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)
}
