NODE_ENV=production
DATABASE_URL=postgresql://hydroland:CHANGE_ME@postgres:5432/hydroland
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=GENERATE_A_32_CHARACTER_MINIMUM_SECRET

# Object storage stays disabled until a private, encrypted, versioned bucket is provisioned and verified.
HYDROLAND_INTEGRATION_OBJECT_STORAGE_STATUS=NOT_SELECTED
HYDROLAND_OBJECT_STORAGE_ENDPOINT=https://OBJECT_STORAGE_ENDPOINT
HYDROLAND_OBJECT_STORAGE_BUCKET=HYDROLAND_PRIVATE_BUCKET
HYDROLAND_OBJECT_STORAGE_REGION=us-east-1
HYDROLAND_OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
HYDROLAND_OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
HYDROLAND_OBJECT_STORAGE_PRIVATE_ACCESS_CONFIRMED=false
HYDROLAND_OBJECT_STORAGE_ENCRYPTION_CONFIRMED=false
HYDROLAND_OBJECT_STORAGE_VERSIONING_CONFIRMED=false

# Store real secrets only in the chosen KMS/secret manager; never commit them.
